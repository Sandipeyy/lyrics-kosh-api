{
  "name": "lyrics-kosh-api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A provider-agnostic lyrics API built for Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "wrangler d1 migrations apply lyrics-kosh-db --local",
    "db:remote": "wrangler d1 migrations apply lyrics-kosh-db --remote"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.4.0"
  }
}
