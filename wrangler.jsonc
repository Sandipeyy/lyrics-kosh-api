
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lyrics-kosh-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lyrics-kosh-db",
      "database_id": "939c73e3-d6aa-4e8e-bddb-f5687165b54c",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_API_BASE_URL": "https://lyrics-kosh-api.977senpai.workers.dev",
    "LRCLIB_USER_AGENT": "LyricsKosh/1.1 (https://github.com/Sandipeyy/lyrics-kosh-api)",
    "LRC_RED_USER_AGENT": "LyricsKosh/1.1 (https://github.com/Sandipeyy/lyrics-kosh-api)"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
