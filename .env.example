# Local development reference only. Cloudflare Worker vars belong in wrangler.jsonc.
APP_ENV=development
PUBLIC_API_BASE_URL=http://localhost:8787
LRCLIB_USER_AGENT=LyricsKosh/1.1 (https://example.com; contact: hello@example.com)
LRC_RED_USER_AGENT=LyricsKosh/1.1 (https://example.com; contact: hello@example.com)

# Set with: npx wrangler secret put ADMIN_SECRET
ADMIN_SECRET=replace-with-a-long-random-secret
